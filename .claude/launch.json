{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "frontend-scratch",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=",
        "VITE_API_TARGET=http://localhost:18089",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5188",
        "--strictPort"
      ],
      "port": 5188
    },
    {
      "name": "frontend-green-check",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx vite --port 5190 --strictPort"
      ],
      "port": 5190
    }
  ]
}