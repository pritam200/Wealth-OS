# ============================================================
# Indian Markets AI Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketai_db
DB_USER=marketai
DB_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — MUST change in production (min 64 chars, random)
JWT_SECRET=S3cr3tK3yF0rD3v0nlyChangeInProdS3cr3tK3yF0rD3v0nlyChangeInProd1234

# Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# AI — Google Gemini
# Get key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# News API (optional)
# Get free key at: https://newsapi.org/register
NEWS_API_KEY=

# Frontend URL (for CORS in prod)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
