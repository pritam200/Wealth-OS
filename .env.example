# ============================================================
# Indian Markets AI Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketai_db
DB_USER=marketai
DB_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — MUST change in production (min 64 chars, random)
JWT_SECRET=S3cr3tK3yF0rD3v0nlyChangeInProdS3cr3tK3yF0rD3v0nlyChangeInProd1234

# Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# ─── AI ──────────────────────────────────────────────────────
# Which model answers: ollama (default, local, free, no key) | gemini | none
# "none" disables every AI path; all deterministic parsing and arithmetic keep working.
LLM_PROVIDER=ollama

# Local model (Ollama). No API key, no per-call cost, nothing leaves the machine.
#   1) brew install ollama && ollama serve
#   2) ollama pull qwen2.5:7b          # then set OLLAMA_MODEL to whatever you pulled
# To switch models, change OLLAMA_MODEL and restart the backend — nothing else.
#   qwen2.5:7b   ~4.7 GB  fast; the throughput choice for bulk email classification
#   qwen2.5:14b  ~9.0 GB  slower, better reasoning/prose
#   llama3.1:8b / mistral:7b / phi4  also work — any Ollama chat model that can emit JSON
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# Fall back to the other provider when the configured one is unreachable.
LLM_FALLBACK_ENABLED=true
# Minimum model confidence for an AI-extracted transaction to import without review.
LLM_MIN_CONFIDENCE=0.85

# Optional hosted provider — only needed if LLM_PROVIDER=gemini.
# Free key at: https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY blank to run entirely on the local model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# News API (optional)
# Get free key at: https://newsapi.org/register
NEWS_API_KEY=

# Frontend URL (for CORS in prod)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
