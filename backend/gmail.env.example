# Gmail OAuth credentials for WealthOS auto-import.
# 1) Copy this file to  gmail.env   (same folder)
# 2) Paste your real values below
# 3) Ask Claude to "relaunch the backend with Gmail" (it will source gmail.env)
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# AES-256 key (base64, 32 bytes) used to encrypt saved statement-unlock passwords under
# Locked Statements. Generate with: openssl rand -base64 32
# If left unset, a random key is generated per-process — fine for local dev, but saved
# passwords stop decrypting after a restart until this is set and kept stable.
PDF_PASSWORD_ENC_KEY=
