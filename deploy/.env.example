# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# `deploy/init-secrets.sh` fills every "generated" value for you.

# --- Address -------------------------------------------------------------------------------
# Your DuckDNS name (free), e.g. myfamily.duckdns.org — or your own domain.
DOMAIN=
DUCKDNS_TOKEN=

# --- Who can sign up (comma-separated). Empty = nobody. -----------------------------------
SIGNUP_ALLOWED_EMAILS=

# --- Database / cache (generated) ----------------------------------------------------------
DB_NAME=marketai_db
DB_USER=marketai
DB_PASSWORD=
REDIS_PASSWORD=

# --- App secrets (generated). Back these up: losing them signs everyone out and makes saved
# --- statement passwords unreadable.
JWT_SECRET=
PDF_PASSWORD_ENC_KEY=

# --- Gmail OAuth (Google Cloud Console → Credentials → OAuth client, type "Web application").
# Authorized redirect URI there must be exactly: https://<DOMAIN>/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Sign-up verification emails (SMTP). e.g. Brevo free tier, or Gmail + an app password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=MarketAI <you@example.com>

# --- AI ------------------------------------------------------------------------------------
# Email reading uses Gemini. Use a key from a billing-enabled project (free-tier prompts may be
# used by Google to improve its products).
GEMINI_API_KEY=
LLM_EMAIL_PROVIDER=gemini
# Other AI features: "ollama" if you start the ollama profile, otherwise "gemini".
LLM_PROVIDER=gemini
OLLAMA_MODEL=qwen2.5:7b
# true = if Gemini fails, read that email with Ollama instead of retrying it next sync.
LLM_FALLBACK_ENABLED=false

# --- Optional ------------------------------------------------------------------------------
NEWS_API_KEY=
