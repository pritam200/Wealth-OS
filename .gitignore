# ── Build output ──────────────────────────────────────────────────────────
# Maven compiles into target/. Tracking it means every build produces a diff of
# hundreds of .class files, which buries real changes and conflicts on every merge.
backend/target/
target/
*.class

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
.vite/
node_modules/
dist/

# ── Secrets ───────────────────────────────────────────────────────────────
# Never commit plaintext credentials. The ONLY secret file that is committed is the encrypted
# bundle config/secrets.tar.gpg (see scripts/secrets.sh and the README).
.env
.env.*
*.env
*.env.*
gmail.env
*.pem
*.key
*.p12
*.p8
*.pfx
# Password / credential dumps by extension only: a bare *password* pattern would also hide real
# source files such as PasswordCipher.java.
*password*.txt
*password*.csv
*password*.json
*credential*.txt
*credential*.csv
*credential*.json
token.json
# Templates carry no values, so they stay tracked.
!.env.example
!**/.env.example
!**/*.env.example
# Where secrets are decrypted to at deploy time. Removed again when the deploy ends.
.tmp-secrets/
config/decrypted/
!backend/tools/*.sh
# The encrypted bundle itself is meant to be committed.
!config/secrets.tar.gpg

# ── IDE ───────────────────────────────────────────────────────────────────
# Editor state is per-developer. backend/.idea/compiler.xml in particular records
# a local JDK path, so tracking it makes one machine's setup everyone's problem.
.idea/
*.iml
.vscode/
*.swp

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs and scratch ──────────────────────────────────────────────────────
*.log
logs/
docs/_build/

# Production secrets and backups (deploy/)
deploy/.env
deploy/backups/

# Claude Code scratch worktrees
.claude/worktrees/
